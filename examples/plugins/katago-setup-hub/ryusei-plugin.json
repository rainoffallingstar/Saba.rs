{
  "schemaVersion": 1,
  "id": "org.ryusei.katago-setup-hub",
  "name": "KataGo Setup & Model Hub",
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": "declarative",
  "permissions": ["engineControl", "fileWrite", "fileRead", "network", "uiPanel"],
  "contributes": {
    "commands": [
      {
        "id": "org.ryusei.katago-setup-hub.setup",
        "title": "Configure Existing KataGo Engine"
      },
      {
        "id": "org.ryusei.katago-setup-hub.download_balanced",
        "title": "Download 10B Balanced Model (94MB)"
      },
      {
        "id": "org.ryusei.katago-setup-hub.download_lightweight",
        "title": "Download Fast Analysis Model (38MB)"
      },
      {
        "id": "org.ryusei.katago-setup-hub.download_strongest",
        "title": "Download Strongest Model (240MB)"
      },
      {
        "id": "org.ryusei.katago-setup-hub.refresh",
        "title": "Refresh KataGo Version and Weights"
      },
      {
        "id": "org.ryusei.katago-setup-hub.update_binary",
        "title": "Update KataGo Binary (Windows/Linux)"
      }
    ],
    "panels": [
      {
        "schemaVersion": 1,
        "pluginId": "org.ryusei.katago-setup-hub",
        "panelTitle": "KataGo Setup & Weights",
        "widgets": [
          {
            "type": "label",
            "text": "探测并配置已安装的 KataGo；可另行下载官方神经网络模型"
          },
          {
            "type": "value",
            "label": "硬件后端",
            "value": "Detected when configuration runs"
          },
          {
            "type": "button",
            "id": "org.ryusei.katago-setup-hub.setup",
            "title": "⚡ 配置已安装的 KataGo"
          },
          {
            "type": "button",
            "id": "org.ryusei.katago-setup-hub.download_balanced",
            "title": "⭐ 10B 均衡推荐网络 (94MB)"
          },
          {
            "type": "button",
            "id": "org.ryusei.katago-setup-hub.download_lightweight",
            "title": "⚡ 快速轻量分析网络 (38MB)"
          },
          {
            "type": "button",
            "id": "org.ryusei.katago-setup-hub.download_strongest",
            "title": "🏆 最强算力大型网络 (240MB)"
          }
        ]
      }
    ]
  }
}
