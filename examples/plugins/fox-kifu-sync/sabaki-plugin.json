{
  "schemaVersion": 1,
  "id": "org.sabaki.fox-kifu-sync",
  "name": "Fox Go Server Kifu Sync",
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": "declarative",
  "permissions": ["gameWrite", "network", "uiPanel"],
  "contributes": {
    "commands": [
      {
        "id": "org.sabaki.fox-kifu-sync.query_user",
        "title": "Query Fox User Account"
      },
      {
        "id": "org.sabaki.fox-kifu-sync.fetch_latest",
        "title": "Fetch Recent Fox Games"
      }
    ],
    "panels": [
      {
        "schemaVersion": 1,
        "pluginId": "org.sabaki.fox-kifu-sync",
        "panelTitle": "野狐棋谱抓取与同步",
        "widgets": [
          {
            "type": "label",
            "text": "输入野狐昵称或账号，一键抓取最近对局"
          },
          {
            "type": "value",
            "label": "当前账号",
            "value": "未选择"
          },
          {
            "type": "button",
            "id": "org.sabaki.fox-kifu-sync.fetch_latest",
            "title": "📥 获取最近公开对局"
          }
        ]
      }
    ]
  }
}
